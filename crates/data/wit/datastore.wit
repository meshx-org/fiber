package meshx:data@0.1.0;

/// Datastore interface for querying data with authorization
interface datastore {
    /// Subquery configuration for nested/related data
    record subquery {
        limit: option<u32>,
    }

    /// A segment in a field path
    variant path-segment {
        /// A field name (e.g., "room_name")
        field(string),
        /// A reference/foreign key to follow (like JOIN)
        %ref(u64),
    }

    /// SELECT clause - what fields to fetch
    record select {
        /// Path to the field, can traverse relationships
        path: list<path-segment>,
        /// Optional subquery for nested data
        subquery: option<subquery>,
    }

    /// Comparison operators
    enum compare-op {
        gt,
        gte,
        lt,
        lte,
        eq,
        ne,
        like,
        ilike,
    }

    /// Value in a WHERE comparison
    variant where-value {
        /// A bound variable (like $1 in prepared statements)
        variable(u32),
        /// A literal value
        literal(value),
    }

    /// Recursive WHERE expression tree
    /// Supports nested AND/OR conditions like: (a = 1 AND b > 2) OR (c = 3)
    variant where-expr {
        /// Comparison: field op value (e.g., age > 18)
        compare(tuple<list<string>, compare-op, where-value>),
        /// IS NULL check
        is-null(list<string>),
        /// IS NOT NULL check
        is-not-null(list<string>),
        /// IN list check: field IN (values)
        %in(tuple<list<string>, list<where-value>>),
        /// NOT IN list check: field NOT IN (values)
        not-in(tuple<list<string>, list<where-value>>),
        /// AND combinator: all conditions must be true
        %and(list<where-expr>),
        /// OR combinator: at least one condition must be true
        %or(list<where-expr>),
        /// NOT: negate the inner condition
        not(where-expr),
    }

    /// Sort order
    enum sort-order {
        asc,
        desc,
    }

    /// ORDER BY clause
    record order-by {
        path: list<string>,
        order: sort-order,
    }

    /// Value types that can be stored/returned
    variant value {
        none,
        text(string),
        text-array(list<string>),
        int(s64),
        float(f64),
        %bool(bool),
        /// Reference to nested data
        nested(u64),
    }

    /// A row of values
    type partial-row = list<value>;

    /// Multiple rows
    type partial-rows = list<partial-row>;

    /// Query result data
    record data {
        /// Main result rows
        rows: partial-rows,
        /// Nested/joined data keyed by reference ID
        nested: list<tuple<u64, partial-rows>>,
    }

    /// A complete query request
    record query {
        table: string,
        select: list<select>,
        /// Optional WHERE clause (recursive expression tree)
        %where: option<where-expr>,
        order-by: list<order-by>,
        limit: option<u32>,
        offset: option<u32>,
    }

    /// Query error
    variant query-error {
        /// Access denied to table or column
        access-denied(string),
        /// Invalid query syntax or structure
        invalid-query(string),
        /// Database error
        database-error(string),
    }

    /// Execute a typed query
    query-structured: func(q: query) -> result<data, query-error>;

    /// Execute a raw SQL query (validated SELECT only)
    query-sql: func(sql: string) -> result<data, query-error>;
}

/// Authorization interface for managing permissions
interface auth {
    /// Actions that can be performed
    enum action {
        read,
        write,
        delete,
        read-column,
        read-row,
    }

    /// A user principal
    record principal {
        id: string,
        roles: list<string>,
        attributes: list<tuple<string, string>>,
    }

    /// Authorization decision
    record auth-decision {
        allowed: bool,
        allowed-columns: option<list<string>>,
        row-filter: option<string>,
    }

    /// Authorization error
    variant auth-error {
        denied,
        table-not-allowed(string),
        column-not-allowed(string),
        invalid-entity(string),
        policy-error(string),
    }

    /// Check if an action is authorized
    is-authorized: func(
        principal: principal,
        action: action,
        resource-type: string,
        resource-id: string,
    ) -> result<bool, auth-error>;

    /// Authorize a table read and get allowed columns
    authorize-table-read: func(
        principal: principal,
        table: string,
        requested-columns: list<string>,
    ) -> result<auth-decision, auth-error>;
}

/// Combined world for datastore with auth
world datastore-world {
    export datastore;
    export auth;
}

/// World for clients that use the datastore
world datastore-client {
    import datastore;
    import auth;
}
