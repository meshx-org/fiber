package meshx:fiber@0.1.0;

interface schema {
    variant field-type {
        text,
        int,
        float,
        json,
        relation,
    }

    record field {
        name: option<string>,
        physical-name: string,
        data-type: field-type,
        meta: list<tuple<string, string>>
    }

    record table {
        name: option<string>,
        physical-name: string,
        fields: list<tuple<string, field>>,
        meta: list<tuple<string, string>>
    }

    record schema {
        tables: list<tuple<string, table>>
    }
}

interface authz {
    record entity {
        type: string,
        id: string,
    }

    resource context {
        init: static func() -> own<context>;
    }

    enum error {
        unauthorized,
        forbidden,
    }

    validate: func(ctx: borrow<context>, action: entity, resource: entity) -> result<bool, error>;
}

interface datastore {
    use authz.{context, error};
    use schema.{schema};

    type data = list<tuple<string, string>>;

    resource query-engine {
        init: static func(schema: schema) -> result<own<query-engine>, error>;
        query: func(context: borrow<context>, query: string) -> result<data, error>;
    }
}